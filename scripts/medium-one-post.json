":{"xsrf":""}}</script><script>window.__APOLLO_STATE__ = {"ROOT_QUERY":{"__typename":"Query","viewer":null,"collectionByDomainOrSlug({\"domainOrSlug\":\"medium.com\"})":null,"postResult({\"id\":\"ab329b197a79\"})":{"__ref":"Post:ab329b197a79"}},"LinkedAccounts:90408e1aad31":{"__typename":"LinkedAccounts","mastodon":null,"id":"90408e1aad31"},"NewsletterV3:65cf83640075":{"__typename":"NewsletterV3","id":"65cf83640075","type":"NEWSLETTER_TYPE_AUTHOR","slug":"90408e1aad31","name":"90408e1aad31","collection":null,"user":{"__ref":"User:90408e1aad31"}},"User:90408e1aad31":{"__typename":"User","id":"90408e1aad31","name":"Samarth Deyagond","username":"deyagondsamarth","newsletterV3":{"__ref":"NewsletterV3:65cf83640075"},"linkedAccounts":{"__ref":"LinkedAccounts:90408e1aad31"},"isSuspended":false,"imageId":"1*ENFQHgYmfLfc4JTVBcpvYg.jpeg","customDomainState":null,"hasSubdomain":false,"verifications":{"__typename":"VerifiedInfo","isBookAuthor":false},"socialStats":{"__typename":"SocialStats","followerCount":101,"followingCount":44,"collectionFollowingCount":12},"bio":"I code for a living & I write for happiness!","membership":null,"allowNotes":true,"viewerEdge":{"__ref":"UserViewerEdge:userId:90408e1aad31-viewerId:lo_7ffe607f566b"},"twitterScreenName":""},"Paragraph:359002722ab1_0":{"__typename":"Paragraph","id":"359002722ab1_0","name":"56d7","type":"H3","href":null,"layout":null,"metadata":null,"text":"The Unsaid!","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_1":{"__typename":"Paragraph","id":"359002722ab1_1","name":"40bb","type":"P","href":null,"layout":null,"metadata":null,"text":"For every compliment you have received, a thousand have gone unspoken!","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":0,"end":70,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:0*8hsyJ6KjSfD-dvWf":{"__typename":"ImageMetadata","id":"0*8hsyJ6KjSfD-dvWf","originalHeight":3720,"originalWidth":5719,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:359002722ab1_2":{"__typename":"Paragraph","id":"359002722ab1_2","name":"20e6","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:0*8hsyJ6KjSfD-dvWf"},"text":"Photo by Manuel Cosentino on Unsplash","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":9,"end":25,"href":"https:\u002F\u002Funsplash.com\u002F@manucosen?utm_source=medium&utm_medium=referral","anchorType":"LINK","userId":null,"linkMetadata":null},{"__typename":"Markup","type":"A","start":29,"end":37,"href":"https:\u002F\u002Funsplash.com?utm_source=medium&utm_medium=referral","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_3":{"__typename":"Paragraph","id":"359002722ab1_3","name":"b49f","type":"P","href":null,"layout":null,"metadata":null,"text":"We live inside an orchestra of quiet reverence. A clerk notices the gentleness in your “thank you.” A colleague watches the way you hold the door a second longer than necessary. A stranger on the street catches the soft concentration on your face and thinks, they look like someone who cares. None of them say anything. The notes rise, swirl, and vanish into the air.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":259,"end":291,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_4":{"__typename":"Paragraph","id":"359002722ab1_4","name":"2df3","type":"P","href":null,"layout":null,"metadata":null,"text":"But the music is real.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_5":{"__typename":"Paragraph","id":"359002722ab1_5","name":"ff40","type":"P","href":null,"layout":null,"metadata":null,"text":"You have been seen more often than you know. Admired more generously than you realize. Loved more widely than your doubts will allow.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_6":{"__typename":"Paragraph","id":"359002722ab1_6","name":"8d91","type":"P","href":null,"layout":null,"metadata":null,"text":"Tonight, let’s gather those unsent messages, unmailed letters, and unvoiced praises — and lay them in your hands like fireflies in a jar. Let them glow. Let them prove a simple, stubborn truth: you matter — in ways you can feel and in ways you can’t.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":194,"end":204,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_7":{"__typename":"Paragraph","id":"359002722ab1_7","name":"0949","type":"H3","href":null,"layout":null,"metadata":null,"text":"The Arithmetic of Quiet Praise","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_8":{"__typename":"Paragraph","id":"359002722ab1_8","name":"0e43","type":"P","href":null,"layout":null,"metadata":null,"text":"There is a soft mathematics to the world’s affection. Every spoken compliment is a lighthouse — visible, unmistakable. But for every lighthouse, there are a thousand small lanterns flickering in windows you pass by: the friend who quotes your words in another room, the teammate who copies your steadiness, the child who never forgot your smile from the elevator. We don’t count the lanterns because they’re not announced. Yet they add up. They multiply. They light the map of your life.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_9":{"__typename":"Paragraph","id":"359002722ab1_9","name":"3ed1","type":"P","href":null,"layout":null,"metadata":null,"text":"If you could eavesdrop on the rooms you’ve left, you would hear it:","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_10":{"__typename":"Paragraph","id":"359002722ab1_10","name":"aa88","type":"ULI","href":null,"layout":null,"metadata":null,"text":"“They make meetings feel lighter.”","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":0,"end":34,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_11":{"__typename":"Paragraph","id":"359002722ab1_11","name":"c4e6","type":"ULI","href":null,"layout":null,"metadata":null,"text":"“I love how they ask, ‘How are you — really?’”","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":0,"end":46,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_12":{"__typename":"Paragraph","id":"359002722ab1_12","name":"f034","type":"ULI","href":null,"layout":null,"metadata":null,"text":"“Have you noticed how they never rush the last person in line?”","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":0,"end":63,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_13":{"__typename":"Paragraph","id":"359002722ab1_13","name":"a5cf","type":"ULI","href":null,"layout":null,"metadata":null,"text":"“They’re not loud about it, but they’re brave.”","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":0,"end":47,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_14":{"__typename":"Paragraph","id":"359002722ab1_14","name":"0cef","type":"P","href":null,"layout":null,"metadata":null,"text":"The world is generous with its witnessing. It simply forgets to speak.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_15":{"__typename":"Paragraph","id":"359002722ab1_15","name":"140e","type":"H3","href":null,"layout":null,"metadata":null,"text":"Why You Matter (Even on the Ordinary Days)","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_16":{"__typename":"Paragraph","id":"359002722ab1_16","name":"6083","type":"P","href":null,"layout":null,"metadata":null,"text":"We’re taught to measure ourselves by finalities: the big win, the promotion, the certificate you can frame. But the universe keeps a different ledger. It writes in small script and quiet ink. It celebrates the day you showed up tired and still tried anyway. It underlines the afternoon you forgave yourself — just a little — and found room to begin again.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_17":{"__typename":"Paragraph","id":"359002722ab1_17","name":"55c4","type":"P","href":null,"layout":null,"metadata":null,"text":"You matter because of the weight you lift from mornings by choosing kindness when frustration is easier. You matter because there are people who breathe easier when you enter the room; your presence adjusts the weather. You matter because a story you’re living — right now, messy and unfinished — has already given someone else the courage to continue theirs.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_18":{"__typename":"Paragraph","id":"359002722ab1_18","name":"6bf0","type":"P","href":null,"layout":null,"metadata":null,"text":"If you’ve ever:","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_19":{"__typename":"Paragraph","id":"359002722ab1_19","name":"ac1b","type":"ULI","href":null,"layout":null,"metadata":null,"text":"answered a message you could have ignored,","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_20":{"__typename":"Paragraph","id":"359002722ab1_20","name":"5184","type":"ULI","href":null,"layout":null,"metadata":null,"text":"watered a plant that was leaning,","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_21":{"__typename":"Paragraph","id":"359002722ab1_21","name":"47a4","type":"ULI","href":null,"layout":null,"metadata":null,"text":"changed your mind when better evidence arrived,","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_22":{"__typename":"Paragraph","id":"359002722ab1_22","name":"b52c","type":"ULI","href":null,"layout":null,"metadata":null,"text":"apologized first,","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_23":{"__typename":"Paragraph","id":"359002722ab1_23","name":"362a","type":"ULI","href":null,"layout":null,"metadata":null,"text":"laughed at your own mistake, or","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_24":{"__typename":"Paragraph","id":"359002722ab1_24","name":"2fc2","type":"ULI","href":null,"layout":null,"metadata":null,"text":"remembered a name —","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_25":{"__typename":"Paragraph","id":"359002722ab1_25","name":"4962","type":"P","href":null,"layout":null,"metadata":null,"text":"you have mended the fabric. You’ve done invisible work that keeps the gears from grinding, the air from tearing, the day from tipping the wrong way. The world notices. Maybe it doesn’t post about it; maybe it doesn’t even tell you. But it notices.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":26,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_26":{"__typename":"Paragraph","id":"359002722ab1_26","name":"1967","type":"H3","href":null,"layout":null,"metadata":null,"text":"Why You Are More Loved Than You Think","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_27":{"__typename":"Paragraph","id":"359002722ab1_27","name":"4fc0","type":"P","href":null,"layout":null,"metadata":null,"text":"Love isn’t only what is proclaimed; often it is what is prepared. The tea set out on the counter before you wake. The article bookmarked for you. The playlist someone made and never admitted was for you. The way a friend recalls the exact brand of pen you prefer. Love is the cushion placed under your fall, even if you never see the hands that set it there.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":56,"end":64,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_28":{"__typename":"Paragraph","id":"359002722ab1_28","name":"3158","type":"P","href":null,"layout":null,"metadata":null,"text":"We underestimate the quiet loves, the ones that don’t perform themselves. Yet they are the ones that hold. They’re steady, durable, ordinary enough to be mistaken for furniture — but try living without them.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_29":{"__typename":"Paragraph","id":"359002722ab1_29","name":"7645","type":"P","href":null,"layout":null,"metadata":null,"text":"There is a constellation of people who would defend you in rooms you’re not in, who would grieve your absence in ways they don’t yet have language for, who silently count on the fact that you are you. You might not see the constellation because you’re standing inside it. But the stars are there.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":188,"end":199,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_30":{"__typename":"Paragraph","id":"359002722ab1_30","name":"dcea","type":"H3","href":null,"layout":null,"metadata":null,"text":"On Compliments: The Currency of Care","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_31":{"__typename":"Paragraph","id":"359002722ab1_31","name":"4fa1","type":"P","href":null,"layout":null,"metadata":null,"text":"Compliments are small acts of justice. They match the world’s reality to our words. When we withhold them, we allow beauty to remain unacknowledged and effort to go underpaid. When we offer them — genuinely, specifically — we settle a debt that kindness is always accruing.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_32":{"__typename":"Paragraph","id":"359002722ab1_32","name":"d6d7","type":"P","href":null,"layout":null,"metadata":null,"text":"A timely compliment does more than lift a mood. It arrests time. It pins a moment to the bulletin board of memory and writes, This mattered. It tells the nervous beginner, keep going. It tells the quiet expert, we see you. It tells the weary soul, rest if you must — but don’t you dare doubt your worth.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":126,"end":140,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":172,"end":182,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":211,"end":221,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":248,"end":302,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_33":{"__typename":"Paragraph","id":"359002722ab1_33","name":"ebfa","type":"P","href":null,"layout":null,"metadata":null,"text":"We sometimes resist giving compliments because we think they’ll make us smaller. But appreciation multiplies. Your praise does not diminish you; it enlarges the room you both share. When you name the good in others, you tune your mind to notice more good — like adjusting a radio until the static clears and the music comes through.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_34":{"__typename":"Paragraph","id":"359002722ab1_34","name":"a121","type":"P","href":null,"layout":null,"metadata":null,"text":"Validation is not a throne to sit upon forever; it’s a bridge. We cross it to reach each other. We cross it to learn how to stand. We cross it until we can carry some of the weight ourselves. To say, “This is good,” doesn’t trap us in the need to always hear it — if anything, it trains us to recognize what goodness feels like, so we can grow more of it.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":247,"end":253,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_35":{"__typename":"Paragraph","id":"359002722ab1_35","name":"450f","type":"H3","href":null,"layout":null,"metadata":null,"text":"The Practice of Saying What Is True","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_36":{"__typename":"Paragraph","id":"359002722ab1_36","name":"a4e6","type":"P","href":null,"layout":null,"metadata":null,"text":"Let this be your gentle practice:","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_37":{"__typename":"Paragraph","id":"359002722ab1_37","name":"f877","type":"OLI","href":null,"layout":null,"metadata":null,"text":"Be specific — “You’re smart” is pleasant; “The way you explained that concept made it feel possible for me” is a keepsake.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":13,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_38":{"__typename":"Paragraph","id":"359002722ab1_38","name":"4cbf","type":"OLI","href":null,"layout":null,"metadata":null,"text":"Be timely — Praise given fresh is a warm loaf — it nourishes different than something reheated.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":11,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_39":{"__typename":"Paragraph","id":"359002722ab1_39","name":"784d","type":"OLI","href":null,"layout":null,"metadata":null,"text":"Be generous, not performative — Compliment to connect, not to transact. People can feel the difference, and so can you.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":31,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_40":{"__typename":"Paragraph","id":"359002722ab1_40","name":"a9db","type":"OLI","href":null,"layout":null,"metadata":null,"text":"Include the invisible — Notice effort, character, and growth, especially when outcomes are still arriving.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":23,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_41":{"__typename":"Paragraph","id":"359002722ab1_41","name":"7f14","type":"OLI","href":null,"layout":null,"metadata":null,"text":"Speak to the person, not the room — Public praise is lovely; private truth can be life-changing.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":36,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_42":{"__typename":"Paragraph","id":"359002722ab1_42","name":"8ff4","type":"P","href":null,"layout":null,"metadata":null,"text":"Consider this your daily ritual: before you close your eyes, name three things someone did today that were good, beautiful, or brave. If you can, tell them. If you can’t, write it down. Either way, you are tuning your heart to the right frequency.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_43":{"__typename":"Paragraph","id":"359002722ab1_43","name":"6132","type":"H3","href":null,"layout":null,"metadata":null,"text":"If You Need to Hear It (You Do)","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_44":{"__typename":"Paragraph","id":"359002722ab1_44","name":"da2e","type":"P","href":null,"layout":null,"metadata":null,"text":"Here is the letter the world meant to send:","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_45":{"__typename":"Paragraph","id":"359002722ab1_45","name":"d13c","type":"BQ","href":null,"layout":null,"metadata":null,"text":"You are not an accident in this universe. You are a chosen arrangement of wonder and dust, patience and lightning. There are mornings you do not believe this; that’s okay. The tide returns whether you watch it or not, and love returns, too — sometimes as a lighthouse, often as a lantern in a window you haven’t noticed yet.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_46":{"__typename":"Paragraph","id":"359002722ab1_46","name":"1700","type":"BQ","href":null,"layout":null,"metadata":null,"text":"You are beautiful in the way bridges are beautiful — because you carry others. You are important in the way seasons are important — because you make change livable. You are precious because there is no replica of your way of seeing, your way of listening, your way of making room.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_47":{"__typename":"Paragraph","id":"359002722ab1_47","name":"d8f5","type":"BQ","href":null,"layout":null,"metadata":null,"text":"Thank you for staying. Thank you for trying again. Thank you for being the kind of person who cares about being kind. The world is better with you in it. It always has been.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_48":{"__typename":"Paragraph","id":"359002722ab1_48","name":"2ba1","type":"H3","href":null,"layout":null,"metadata":null,"text":"The Thousand Unsaid","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_49":{"__typename":"Paragraph","id":"359002722ab1_49","name":"a41d","type":"P","href":null,"layout":null,"metadata":null,"text":"Return to the beginning: For every compliment you have received, a thousand have gone unspoken. Imagine those thousand now, gathering like birds on a wire. Hear the murmuration of their wings. They are not imaginary; they are simply unrecorded. Let them surround you until the air is thick with recognition. Let them remind you that your life has been raining goodness on people who never learned to forecast.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":25,"end":95,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_50":{"__typename":"Paragraph","id":"359002722ab1_50","name":"cead","type":"P","href":null,"layout":null,"metadata":null,"text":"And then — let one of those birds fly from you to someone else. Catch a person doing something quietly excellent and give it a shape, a sentence, a smile that lands. Do not hoard the light. Spend it. The economy of grace is the only market that grows by giving everything away.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_51":{"__typename":"Paragraph","id":"359002722ab1_51","name":"ccde","type":"H3","href":null,"layout":null,"metadata":null,"text":"A Small Pledge","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_52":{"__typename":"Paragraph","id":"359002722ab1_52","name":"e0fb","type":"P","href":null,"layout":null,"metadata":null,"text":"If you’re willing, place your hand over your heart and say softly:","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_53":{"__typename":"Paragraph","id":"359002722ab1_53","name":"7b5f","type":"BQ","href":null,"layout":null,"metadata":null,"text":"“I will not wait for perfection to acknowledge what is good. I will not be stingy with truth. I will notice, I will name, and I will nurture the light — in others, and in myself.”","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_54":{"__typename":"Paragraph","id":"359002722ab1_54","name":"7ca8","type":"P","href":null,"layout":null,"metadata":null,"text":"The world does not need louder echoes; it needs clearer voices. Yours can be one.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_55":{"__typename":"Paragraph","id":"359002722ab1_55","name":"4567","type":"P","href":null,"layout":null,"metadata":null,"text":"So the next time doubt leans close and whispers that you are ordinary, answer with this: Even ordinary stars light entire nights. And the next time you think a kind thought about someone — say it. Text it. Write it on a sticky note. Leave it in a margin. Make timely praise your habit, and watch how the universe answers.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":255,"end":321,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":89,"end":129,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_56":{"__typename":"Paragraph","id":"359002722ab1_56","name":"6fc7","type":"P","href":null,"layout":null,"metadata":null,"text":"Because somewhere, someone is walking home a little taller today — because of you. And perhaps you are, too, because of them. The compliments we give are bridges we get to cross together.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_57":{"__typename":"Paragraph","id":"359002722ab1_57","name":"f632","type":"P","href":null,"layout":null,"metadata":null,"text":"And if no one has told you lately:","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_58":{"__typename":"Paragraph","id":"359002722ab1_58","name":"529d","type":"PQ","href":null,"layout":null,"metadata":null,"text":"You are loved more than you think.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":34,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_59":{"__typename":"Paragraph","id":"359002722ab1_59","name":"94bc","type":"P","href":null,"layout":null,"metadata":null,"text":"Thanks for reading. Have a good one!","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:359002722ab1_60":{"__typename":"Paragraph","id":"359002722ab1_60","name":"ab68","type":"P","href":null,"layout":null,"metadata":null,"text":"|| श्रीकृष्णार्पणमस्तु ||","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":25,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"UserViewerEdge:userId:90408e1aad31-viewerId:lo_7ffe607f566b":{"__typename":"UserViewerEdge","id":"userId:90408e1aad31-viewerId:lo_7ffe607f566b","isMuting":false},"PostViewerEdge:postId:a